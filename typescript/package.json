{
  "name": "@scalix-world/sdk",
  "version": "1.3.4",
  "description": "The official client for Scalix Cloud — one token for AI inference, database, functions, storage, KV, auth, and every platform service. Generated from the OpenAPI spec.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsc --watch -p tsconfig.esm.json",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && vitest run",
    "test:unit": "vitest run",
    "clean": "rm -rf dist",
    "sync-version": "node scripts/sync-version.mjs",
    "generate:ts": "node scripts/sync-version.mjs && openapi-ts && tsc --noEmit -p tsconfig.generated.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "llm",
    "sdk",
    "scalix",
    "chat",
    "tts",
    "rag",
    "typescript"
  ],
  "author": "Scalix World <sdk@scalix.world>",
  "license": "MIT",
  "homepage": "https://scalix.world",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scalixworld/scalix-world-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/scalixworld/scalix-world-sdk/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@types/node": "^26.0.1",
    "eslint": "^10.6.0",
    "openai": "^6.45.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.9"
  }
}
